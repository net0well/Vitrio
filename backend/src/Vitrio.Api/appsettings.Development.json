{
  "ConnectionStrings": {
    "Redis": "127.0.0.1:6379"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}" }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ]
  },
  "Jwt": {
    "Issuer": "http://localhost:5080",
    "Audience": "vitrio-app-dev"
  },
  "Storage": {
    "ServiceUrl": "http://127.0.0.1:8333",
    "UploadServiceUrl": "http://10.0.2.2:8333",
    "PublicBaseUrl": "http://10.0.2.2:8333/vitrio-public",
    "CreateBuckets": true
  },
  "Email": {
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "Security": "None"
    }
  }
}
