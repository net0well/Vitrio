        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ]
  },
  "Jwt": {
    "Issuer": "http://localhost:5080",
    "Audience": "vitrio-app-dev"
  },
  "PublicLinks": {
    "BaseUrl": "http://10.0.2.2:5080",
    "AndroidPackage": "app.vitrio.dev",
    "AndroidCertificateFingerprints": [ "DB:D1:63:F5:63:B5:CB:5C:83:38:F1:5E:F0:1D:B8:4D:5A:F9:E6:50:7D:F3:B3:88:C2:4E:A1:D9:BB:31:1E:6D" ]
  },
  "Storage": {
    "ServiceUrl": "http://127.0.0.1:8333",
