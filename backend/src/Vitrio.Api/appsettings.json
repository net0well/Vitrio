{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://api.vitrio.app",
    "Audience": "vitrio-app"
  },
  "Email": {
    "From": "nao-responda@vitrio.app",
    "FromName": "Vitrio"
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Search": {
    "Relevance": {
      "Text": 0.35,
      "Rating": 0.25,
      "Reviews": 0.15,
      "Proximity": 0.15,
      "Completeness": 0.05,
      "AvailableToday": 0.05
    }
  }
}
